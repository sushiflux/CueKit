*.p12
*.snk
*.pem
*.key
/signing/

# Lokale Umgebung (von start.ps1 erzeugt)
.env
.env.*
!.env.example

# Laufzeitdaten (SQLite, DataProtection-Schluessel) - nie committen.
# Ordnerregeln bewusst am Repo-Stamm verankert: Git ignoriert unter Windows Gross-/Klein-
# schreibung, ein nacktes "data/" traefe sonst auch backend/Data (Datenmodell + Migrationen!).
*.db
*.db-shm
*.db-wal
/data/
/keys/
/secrets/

# Playwright
frontend/e2e/test-results/
frontend/e2e/playwright-report/

# Editoren/OS
.vs/
.idea/
*.user
.DS_Store
Thumbs.db

# Android
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/*.keystore
/android/*.jks

