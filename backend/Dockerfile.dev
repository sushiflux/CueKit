# Dev-Image: dotnet watch mit Hot-Reload auf dem per Bind-Mount eingehaengten Quellcode.
FROM mcr.microsoft.com/dotnet/sdk:10.0

# Node.js-Laufzeit fuer Community-Plugins (JavaScript/TypeScript), direkt aus dem offiziellen Image.
COPY --from=node:24-slim /usr/local/bin/node /usr/local/bin/node

WORKDIR /app
# Bind-Mounts von Windows liefern keine inotify-Events -> Polling.
ENV DOTNET_USE_POLLING_FILE_WATCHER=1 \
    DOTNET_WATCH_RESTART_ON_RUDE_EDIT=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1

EXPOSE 8080
CMD ["dotnet", "watch", "run", "--no-launch-profile", "--non-interactive"]
